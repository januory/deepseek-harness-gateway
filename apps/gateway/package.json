{
  "name": "@januory/dsh-gateway-server",
  "version": "0.2.0",
  "type": "module",
  "description": "deepseek-harness-gateway: multi-tenant managed gateway router (control plane + router + portal hosting).",
  "bin": {
    "dshgw": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "build": "tsc --noEmit && node scripts/bundle.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^8.0.3",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
