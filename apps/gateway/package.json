    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "dsh-gateway-protocol": "workspace:*",
    "dsh-gateway-store": "workspace:*",
    "esbuild": "^0.25.12",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "publishConfig": {
