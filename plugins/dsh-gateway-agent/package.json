{
  "name": "@januory/dsh-gateway-agent",
  "version": "0.2.0",
  "type": "module",
  "description": "客户机接入插件：出站连接 deepseek-harness-gateway，桥接本机 dsh web 供门户完整操控。",
  "repository": {
    "type": "git",
    "url": "https://github.com/januory/deepseek-harness-gateway.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./daemon": "./src/daemon.js"
  },
  "bin": {
    "dsh-gateway-supervisor": "./src/daemon.js"
  },
  "files": ["src", "service", "cordis.patch.yml"],
  "dependencies": {
    "ws": "^8.18.0"
  },
  "scripts": {
    "build": "node -e \"console.log('dsh-gateway-agent: no build (plain JS)')\"",
    "supervisor": "node src/daemon.js",
    "test": "node test/secrets.test.js && node test/backoff.test.js && node test/origin.test.js && node test/daemon-config.test.js && node test/daemon.test.js && node test/daemon-rpc.test.js && node test/iife-isolation.mjs",
    "typecheck": "node -e \"console.log('dsh-gateway-agent: plain JS, typecheck skipped')\""
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  }
}
