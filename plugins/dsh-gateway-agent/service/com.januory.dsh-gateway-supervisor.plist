<?xml version="1.0" encoding="UTF-8"?>
<!--
  dsh-gateway-agent — launchd agent for the dsh LIFECYCLE SUPERVISOR.

  What this supervises is the SUPERVISOR (daemon.js), not dsh itself: the
  supervisor is what starts/stops/restarts dsh on the gateway's request. If dsh
  is also managed by launchd, pick ONE owner — the supervisor.

  REFERENCE ONLY — install with the script, which resolves the real paths:
      ./install-supervisor-launchd.sh            # install
      ./install-supervisor-launchd.sh status
      ./install-supervisor-launchd.sh uninstall

  Two things break a hand-edited copy on a stock Mac:
    * launchd's PATH is /usr/bin:/bin:/usr/sbin:/sbin, so `/usr/bin/env node`
      cannot find a Homebrew (/opt/homebrew/bin, /usr/local/bin) or nvm node.
      Use an ABSOLUTE node path below, never `/usr/bin/env node`.
    * the supervisor runs the lifecycle scripts in that same minimal PATH, so
      `dsh` must be on the PATH recorded here as well.

  The script handles both and uses `launchctl bootstrap gui/$UID` (the supported
  API; `load -w` above is the legacy fallback).

  KeepAlive restarts the SUPERVISOR if it dies, and the supervisor's bootstrap
  brings dsh back up when its liveness probe says dsh is down. A dsh that
  crashes while the supervisor stays up is reported as `exited` and needs an
  explicit Start from the portal.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.januory.dsh-gateway-supervisor</string>

    <key>ProgramArguments</key>
    <array>
      <!-- Absolute path; see the PATH note above. -->
      <string>/usr/local/bin/node</string>
      <string>SUPERVISOR_ENTRY</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
      <!-- Same $DSH_HOME the plugin/dsh uses; omit to default to ~/.dsh. -->
      <key>DSH_HOME</key>
      <string>/Users/YOUR_USER/.dsh</string>
      <!-- launchd's minimal PATH plus the directories a Homebrew/nvm install
           lives in, so the supervisor's `dsh web` start script resolves. -->
      <key>PATH</key>
      <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/YOUR_USER/Library/Logs/dsh-gateway-supervisor.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/YOUR_USER/Library/Logs/dsh-gateway-supervisor.err.log</string>
  </dict>
</plist>
